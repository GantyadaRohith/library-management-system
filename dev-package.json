{
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:functions\"",
    "dev:client": "cd client && npm start",
    "dev:functions": "netlify dev",
    "build": "cd client && npm run build",
    "build:functions": "echo 'Functions built automatically'",
    "deploy": "git add -A && git commit -m 'Auto deploy' && git push",
    "test:api": "node test-api.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "netlify-cli": "^17.0.0"
  }
}